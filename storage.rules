rules_version = '2';

// Nutrition-label photos. Same single-owner pin as Firestore.
//
// The UID below is the single owner account. Changing accounts means
// updating it here and redeploying: firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    function ownerUid() {
      return 'pvB84RHsdRZ6WCvjnbPAfyKMR542';
    }

    function isOwner() {
      return request.auth != null && request.auth.uid == ownerUid();
    }

    // Label photos live under labels/{uid}/...
    match /labels/{userId}/{allPaths=**} {
      allow read: if isOwner() && userId == ownerUid();

      // Images only, 10 MB ceiling — a phone photo of a label is well under.
      allow write: if isOwner()
        && userId == ownerUid()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isOwner() && userId == ownerUid();
    }

    // Private monthly progress photos, stored separately from food labels.
    match /progress/{userId}/{allPaths=**} {
      allow read: if isOwner() && userId == ownerUid();
      allow write: if isOwner()
        && userId == ownerUid()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner() && userId == ownerUid();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
